# Copy this to backend/.env (or project-root .env) and fill in what you need.
# NEVER commit the real .env file. This file must never contain real secrets.
#
# NOTE: this file previously pointed MODEL_PATH at a non-existent path
# (./models/khetsetu_model.keras) with DEMO_MODE=true, which would silently
# force every prediction through the random demo predictor instead of the
# real model. That mismatch is fixed below to match backend/app/config.py.

# --- ML ----------------------------------------------------------------
# Leave MODEL_PATH empty to auto-detect model/khetsetu.tflite (preferred)
# or model/khetsetu.keras inside MODEL_DIR.
MODEL_PATH=
CONFIDENCE_THRESHOLD=0.70
# auto  -> real trained model if model/ has one, otherwise clearly labelled demo predictions
# false -> real model required; /api/predict returns 503 if it cannot be loaded (production)
# true  -> force simulated "Demo Mode" predictions
DEMO_MODE=false

# --- CORS ----------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional integrations (project works fully without these) ----------
# Gemini: additive farmer-friendly explanation text ONLY. It never decides
# the disease class. Leave blank to use guidance.json text directly.
GEMINI_API_KEY=
# Sarvam: optional Hindi TTS provider. Leave blank to use the browser's
# built-in Web Speech API instead.
SARVAM_API_KEY=
# data.gov.in / Agmarknet market-price API key. Leave blank -> demo market data.
MARKET_API_KEY=

# --- WhatsApp Cloud API (server side only) --------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite:///./khetsetu.db
