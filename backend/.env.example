# Copy to backend/.env  (PowerShell:  Copy-Item ..\.env.example .env)   NEVER commit the real .env

# ---- Model -------------------------------------------------------------------
# Leave MODEL_PATH empty to auto-use model/khetsetu.tflite (or model/khetsetu.keras).
MODEL_PATH=
CONFIDENCE_THRESHOLD=0.70
# auto  = real trained model if model/ has one, otherwise clearly labelled demo predictions
# false = real model only (API answers 503 if it cannot be loaded) - REQUIRED for production
# true  = force simulated "Demo Mode" predictions
# The trained model ships inside model/, so this is "false": predictions always come
# from the real MobileNetV2 classifier, never a silent random fallback.
DEMO_MODE=false

# ---- Runtime and authentication ----------------------------------------------
# Use production only when both server secrets below have been configured.
APP_ENV=dev
REQUIRE_AUTH=false
# Supabase JWT signing secret; server-side only, never expose to the frontend.
SUPABASE_JWT_SECRET=

# ---- Web app -----------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- WhatsApp Cloud API (server side only) ------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# optional but recommended: your Meta app secret, enables webhook signature checking
WHATSAPP_APP_SECRET=

# ---- Mandi prices (data.gov.in / Agmarknet) -----------------------------------
# Leave empty -> clearly labelled "Demo market data". Fill in -> live prices.
MARKET_API_KEY=

# ---- Optional extras -----------------------------------------------------------
# Required for translated diagnosis guidance in Kannada, Tamil, Telugu, Marathi,
# and Bengali. English and Hindi guidance are bundled locally.
SARVAM_API_KEY=
GEMINI_API_KEY=
# Gemini model used only for optional grounded explanations.
GEMINI_MODEL=gemini-3.8-flash
SUPABASE_URL=